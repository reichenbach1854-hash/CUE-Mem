# Copy to .env locally and fill only the services you actually use.
# Never commit the filled file.

# OpenAI-compatible LLM scripts
CUE_MEM_LLM_API_KEY=
CUE_MEM_LLM_BASE_URL=
CUE_MEM_LLM_MODEL=deepseek-v4-pro

# QA caption and question-generation overrides. Leave blank to fall back to
# the generic CUE_MEM_LLM_* settings where the script supports that fallback.
CUE_MEM_QA_IMAGE_API_KEY=
CUE_MEM_QA_IMAGE_BASE_URL=
CUE_MEM_QA_IMAGE_MODEL=
CUE_MEM_QA_AUDIO_API_KEY=
CUE_MEM_QA_AUDIO_BASE_URL=
CUE_MEM_QA_AUDIO_MODEL=
CUE_MEM_QA_NOUN_LLM_MODEL=
CUE_MEM_QA_ENTITY_IMAGE_MODEL=
CUE_MEM_HTTP_REFERER=

# Kling background audio
CUE_MEM_KLING_ACCESS_KEY=
CUE_MEM_KLING_SECRET_KEY=
CUE_MEM_KLING_BASE_URL=

# Volcengine image generation
CUE_MEM_IMAGE_VOLC_ACCESS_KEY=
CUE_MEM_IMAGE_VOLC_SECRET_KEY=
CUE_MEM_IMAGE_VOLC_BASE_URL=
CUE_MEM_IMAGE_VOLC_HOST=
CUE_MEM_IMAGE_VOLC_REGION=cn-north-1
CUE_MEM_IMAGE_VOLC_SERVICE=cv
CUE_MEM_IMAGE_VOLC_VERSION=2022-08-31

# TOS reference-image upload (event image generation only)
CUE_MEM_IMAGE_TOS_ACCESS_KEY=
CUE_MEM_IMAGE_TOS_SECRET_KEY=
CUE_MEM_IMAGE_TOS_ENDPOINT=
CUE_MEM_IMAGE_TOS_PUBLIC_BASE_URL=
CUE_MEM_IMAGE_TOS_BUCKET=
CUE_MEM_IMAGE_TOS_REGION=cn-beijing
CUE_MEM_IMAGE_TOS_PREFIX=ref_images/
CUE_MEM_IMAGE_USE_REFERENCE=1

# OpenRouter-compatible image generation
CUE_MEM_IMAGE_OPENROUTER_API_KEY=
CUE_MEM_IMAGE_OPENROUTER_BASE_URL=
CUE_MEM_IMAGE_OPENROUTER_MODEL=

# AIFast-compatible image generation
CUE_MEM_IMAGE_AIFAST_API_KEY=
CUE_MEM_IMAGE_AIFAST_BASE_URL=
CUE_MEM_IMAGE_AIFAST_MODEL=
CUE_MEM_IMAGE_AIFAST_SIZE=1K

# Local OpenAI-compatible image generation
CUE_MEM_IMAGE_LOCAL_API_KEY=
CUE_MEM_IMAGE_LOCAL_BASE_URL=
CUE_MEM_IMAGE_LOCAL_MODEL=free-t2i
CUE_MEM_IMAGE_LOCAL_INTERVAL=60
CUE_MEM_IMAGE_LOCAL_BACKOFF_BASE=60
CUE_MEM_IMAGE_LOCAL_BACKOFF_MAX=600

# Optional local project/model location overrides
CUE_MEM_PROJECT_ROOT=
CUE_MEM_BENCHMARK_ROOT=

# RQ1/RQ2 benchmark data and generated-output locations
CUE_MEM_DATA_ROOT=
CUE_MEM_RESULT_ROOT=
CUE_MEM_QUESTION_ONLY_RESULT_ROOT=
CUE_MEM_ORACLE_RESULT_ROOT=
CUE_MEM_JUDGE_RESULT_ROOT=
CUE_MEM_TRIMMED_RESULT_ROOT=
CUE_MEM_PROMPT_ROOT=
CUE_MEM_CACHE_ROOT=
CUE_MEM_MEMORY_CACHE_ROOT=
CUE_MEM_QA_ROOT=
CUE_MEM_EVENT_ROOT=
CUE_MEM_RQ3_ROOT=
CUE_MEM_LOG_ROOT=

# RQ1/RQ2 optional model and runtime settings
CUE_MEM_PYTHON=python
CUE_MEM_BENCHMARK_CONDA_ENV=
CUE_MEM_VLLM_COMMAND=vllm
CUE_MEM_VLLM_MODEL_PATH=
CUE_MEM_VLLM_HEALTH_URL=
CUE_MEM_VLLM_API_KEY=
CUE_MEM_VLLM_BASE_URL=
CUE_MEM_VLLM_PORT=
CUE_MEM_VLLM_HOST=0.0.0.0
CUE_MEM_VLLM_SERVED_MODEL=
CUE_MEM_VLLM_MAX_MODEL_LEN=
CUE_MEM_VLLM_REASONING_PARSER=qwen3
CUE_MEM_VLLM_WAIT_ATTEMPTS=
CUE_MEM_VLLM_WAIT_INTERVAL=
CUE_MEM_LLM_JUDGE_MODEL=
CUE_MEM_AUDIO_PROVIDER=
CUE_MEM_BACKBONE_PATH=
CUE_MEM_TEXT_ENCODER_PATH=
CUE_MEM_CLIP_MODEL_PATH=
CUE_MEM_GME_MODEL_PATH=
CUE_MEM_GME_QWEN2_VL_7B_PATH=
CUE_MEM_GME_QWEN2_VL_2B_PATH=
CUE_MEM_INSPECT_OUTPUT=
AMEM_API_KEY=
AMEM_API_BASE=
MEMORYOS_API_KEY=
MEMORYOS_API_BASE=

# RQ3 paths (data, embeddings, prompts and results are external/generated)
CUE_MEM_RQ3_ROOT=
RQ3_DATA_DIR=
RQ3_HISTORY_DIR=
RQ3_IMAGE_DIR=
RQ3_VOICE_DIR=
RQ3_QA_IMAGE_DIR=
RQ3_EMBEDDING_DIR=
RQ3_RESULT_DIR=
RQ3_PROMPT_DIR=
RQ3_ADVERSARIAL_QA_FILE=
RQ3_ENTITY_SOURCE_DIR=
RQ3_CORRECT6_FILE=

# RQ3 evaluation and embedding services
RQ3_EVAL_MODEL_PROVIDER=vllm
RQ3_OMNI_MODEL=qwen3-omni
RQ3_OMNI_API_BASE=
RQ3_OMNI_API_KEY=
RQ3_ALIYUN_OMNI_MODEL=qwen3.5-omni-plus
RQ3_ALIYUN_OMNI_API_BASE=
RQ3_ALIYUN_OMNI_API_KEY=
RQ3_EMBEDDING_PROVIDER=imagebind
RQ3_GEMINI_EMBEDDING_MODEL=google/gemini-embedding-2
RQ3_GEMINI_EMBEDDING_API_BASE=
RQ3_GEMINI_EMBEDDING_API_KEY=
RQ3_GEMINI_EMBEDDING_DIM=3072
RQ3_IMAGEBIND_DEVICE=cuda:0
RQ3_IMAGEBIND_MODEL=imagebind_huge
RQ3_IMAGEBIND_EMBEDDING_DIM=1024

# Optional compatibility aliases accepted by the RQ3 service wrappers
DASHSCOPE_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_API_BASE=
GEMINI_EMBEDDING_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_BASE=
OPENROUTER_API_KEY=
